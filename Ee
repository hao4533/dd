nano giaithua_B2305569.c

#include "libB2305569.h"

long giaithua_B2305569(int n) {
if (n <= 1) return 1;
long result = 1;
for (int i = 2; i <= n; i++) {
result *= i;
}
return result;
}

nano tongchan_B2305569.c

#include "libB2305569.h"

int tongchan_B2305569(int n) {
int sum = 0;
for (int i = 2; i <= n; i += 2) {
sum += i;
}
return sum;
}

nano luythua_B2305569.c

#include "libB2305569.h"

long luythua_B2305569(int x, int n) {
long result = 1;
for (int i = 0; i < n; i++) {
result *= x;
}
return result;
}

